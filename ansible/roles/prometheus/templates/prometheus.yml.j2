global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node_exporter
    static_configs:
      - targets:
{% for host in groups['tag_Role_private_app'] | default([]) %}
          - "{{ host }}:9100"
{% endfor %}
        labels:
          env: "{{ lookup('env', 'ENVIRONMENT') | default('dev') }}"

{# Router metrics - add this job when node_exporter is running on the router:
  - job_name: router
    static_configs:
      - targets:
        - "<router-private-ip>:9100"
#}